#!/usr/bin/env python3
"""Print this cluster's LOCAL CATALOG (hpc-bridge seed-format YAML): the one entry for the PBS facility endpoint,
`fake-pbs-mep`, its UUID read from the endpoint.json the manager writes at its first start. Exit 1 (nothing printed)
until it has registered — the readiness wait and run_smoke.sh retry on that. Runs inside the login node (installed by
setup.d/login-pbsmep.sh); HPCB_MEP_STATE_DIR overrides /root/.globus_compute (the hermetic test).

The entry mirrors the registry's `polaris` seed (src/hpc_bridge/catalog/seed/alcf-polaris.yaml): PBS, account required
(with a hint that does not name the account), `compute.key_map` partition -> queue, NO env_setup (the template puts the
facility's own endpoint venv on the workers' PATH, so the worker matches the user endpoint by construction), a short
`debug` default and a warm block. The description names no account: the agent must ask, or be told, which to charge.

A SECOND entry, `fake-pbs-mep-req` (block environments, PR 3), follows once the second manager (`hpcb-mep-pbs-req`, the
same template that also builds `requirements`) has registered: the same contract under its own UUID. Only the first
gates the exit status, so a failed second manager never takes the profile's other cells down."""
import datetime
import json
import os
import sys

STATE = os.environ.get("HPCB_MEP_STATE_DIR", "/root/.globus_compute")
NAME = "hpcb-mep-pbs"
REQ_NAME = "hpcb-mep-pbs-req"


def _uuid(name: str, *, quiet: bool = False) -> str | None:
    p = os.path.join(STATE, name, "endpoint.json")
    try:
        with open(p) as fh:
            return str(json.load(fh)["endpoint_id"])
    except Exception as exc:  # noqa: BLE001 - not registered yet
        if not quiet:
            print(f"hpcb-pbs-mep-catalog: {p}: {exc}", file=sys.stderr)
        return None


eid = _uuid(NAME)
if eid is None:
    sys.exit(1)
print("# hpc-bridge fake PBS cluster — LOCAL catalog generated by hpcb-pbs-mep-catalog (the MEP UUID is minted per cluster)")
print(f"""- id: fake-pbs-mep
  facility_key: fake-pbs
  facility: "hpc-bridge fake PBS cluster"
  description: "the fake PBS cluster (Polaris-shaped) via its facility multi-user endpoint — zero SSH; compute-only (queues workq/debug); a project (account) is required"
  display_name: "fake PBS cluster MEP (Polaris-shaped)"
  aliases: [{NAME}, fake-polaris-mep]
  compute_mep_uuid: {eid}
  ssh_host: null
  auth_method: ssh-key
  allocation: null
  account_required: true
  account_hint: "your project on the fake PBS cluster, as your PI or the cluster's project list names it"
  compute:
    scheduler: pbs
    interface: eth0
    env_setup: ""
    key_map:
      partition: queue
    scratch_root: "$HOME/.hpc-bridge"
    endpoint_name: {NAME}
  defaults:
    partition: debug
    walltime: "00:15:00"
    max_workers_per_node: 2
    nodes_per_block: 1
    init_blocks: 1
    max_blocks: 1
  provenance: session
  last_validated: {datetime.date.today().isoformat()}
""", end="")
req = _uuid(REQ_NAME, quiet=True)
if req is not None:
    print(f"""- id: fake-pbs-mep-req
  facility_key: fake-pbs
  facility: "hpc-bridge fake PBS cluster"
  description: "the fake PBS cluster (Polaris-shaped) via its second facility multi-user endpoint, whose template builds requirements into the workers' environment — zero SSH; compute-only (queues workq/debug); a project (account) is required"
  display_name: "fake PBS cluster MEP (Polaris-shaped, builds requirements)"
  aliases: [{REQ_NAME}]
  compute_mep_uuid: {req}
  ssh_host: null
  auth_method: ssh-key
  allocation: null
  account_required: true
  account_hint: "your project on the fake PBS cluster, as your PI or the cluster's project list names it"
  compute:
    scheduler: pbs
    interface: eth0
    env_setup: ""
    key_map:
      partition: queue
    scratch_root: "$HOME/.hpc-bridge"
    endpoint_name: {REQ_NAME}
  defaults:
    partition: debug
    walltime: "00:15:00"
    max_workers_per_node: 2
    nodes_per_block: 1
    init_blocks: 1
    max_blocks: 1
  provenance: session
  last_validated: {datetime.date.today().isoformat()}
""", end="")
