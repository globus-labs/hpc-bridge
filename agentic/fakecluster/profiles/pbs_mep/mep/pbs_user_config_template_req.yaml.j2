{#- The fake PBS cluster's SECOND user-endpoint template (manager `hpcb-mep-pbs-req`, block environments, PR 3): the
    Polaris-shaped one (pbs_user_config_template.yaml.j2: `queue` and `account` required, the facility's own address,
    `#PBS -l filesystems=home` by default, 240 s idle release, the facility's endpoint venv appended to the workers'
    PATH) that ALSO builds a client's `requirements` into the WORKERS' environment when a block starts — the kind of
    NCSA Delta's (4.19) and Purdue Anvil's (4.16) published templates, after globus-compute-endpoint 4.17's default:
    - BEFORE any user worker_init (as 4.17's environment script runs), a uv venv under ~/.globus_compute/venvs/, keyed
      by the Python, the endpoint's version and a hash of the requirements text; in it the endpoint at the facility's
      own version (so the worker still matches the user endpoint) and the requirements; then activated, so the worker
      runs in it. Built once per key and reused by later blocks; the block that builds it bills the build.
    - the text arrives JSON-quoted (the manager json.dumps every string): its quotes are cut (`[1:-1]`) and its JSON
      escapes are YAML's own in this double-quoted string, so the file the installer reads is the client's text,
      written through a QUOTED here-document (the shell never expands it).
    - a user `worker_init` then runs, and the facility's PATH entry comes last (appended: the venv's bin stays first).
    @@VER@@ is the manager's endpoint version (setup.d/login-pbsmep.sh substitutes it, as the `mep` profile's does). -#}
engine:
  type: GlobusComputeEngine
  run_in_sandbox: true
  max_workers_per_node: {{ max_workers_per_node | default(2) }}
{% if available_accelerators is defined %}
  available_accelerators: {{ available_accelerators }}
{% endif %}
  address:
    type: address_by_interface
    ifname: eth0
  job_status_kwargs:
    max_idletime: {{ max_idletime | default(240) }}
    strategy_period: 5
  provider:
    type: PBSProProvider
    queue: {{ queue }}
    account: {{ account }}
    walltime: {{ walltime | default("00:30:00" | tojson) }}
    nodes_per_block: {{ nodes_per_block | default(1) }}
    cpus_per_node: {{ cpus_per_node | default(4) }}
{% if select_options is defined %}
    select_options: {{ select_options }}
{% endif %}
    scheduler_options: {{ scheduler_options | default("#PBS -l filesystems=home" | tojson) }}
    worker_init: "export TMPDIR=/tmp{% if requirements is defined %}; __gc_rf=$(mktemp); cat > \"$__gc_rf\" <<'GC_REQUIREMENTS_EOF'\n{{ requirements[1:-1] }}\nGC_REQUIREMENTS_EOF\n__gc_rh=$(sha256sum \"$__gc_rf\" | cut -c1-12); __gc_rv=$HOME/.globus_compute/venvs/py3.11-gce@@VER@@-$__gc_rh; mkdir -p \"$HOME/.globus_compute/venvs\"; [ -x \"$__gc_rv/bin/process_worker_pool.py\" ] || { uv venv -q --python /opt/hpcb-mep/gce/bin/python \"$__gc_rv\" && uv pip install -q --python \"$__gc_rv/bin/python\" globus-compute-endpoint==@@VER@@ -r \"$__gc_rf\"; }; rm -f \"$__gc_rf\"; export VIRTUAL_ENV=\"$__gc_rv\" PATH=\"$__gc_rv/bin:$PATH\"{% endif %}{{ ('; ' ~ worker_init[1:-1]) if worker_init is defined else '' }}; export PATH=$PATH:/opt/hpcb-mep/gce/bin"
    launcher:
      type: SimpleLauncher
    init_blocks: {{ init_blocks | default(0) }}
    min_blocks: {{ min_blocks | default(0) }}
    max_blocks: {{ max_blocks | default(1) }}
