{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hpcb-mep-pbs-req user_endpoint_config",
  "description": "The Polaris-shaped PBS contract (hpcb-mep-pbs's, STRICT: `queue` and `account` required, only the keys below accepted) plus `requirements`: a requirements.txt-style text the template builds into the workers' environment when a block starts (the kind of NCSA Delta's and Purdue Anvil's templates, after globus-compute-endpoint 4.17's default).",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue", "account"],
  "properties": {
    "queue": {"type": "string", "minLength": 1},
    "account": {"type": "string", "minLength": 1},
    "walltime": {"type": "string", "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$"},
    "nodes_per_block": {"type": "integer", "minimum": 1, "maximum": 2},
    "cpus_per_node": {"type": "integer", "minimum": 1, "maximum": 4},
    "max_workers_per_node": {"type": "integer", "minimum": 1, "maximum": 4},
    "available_accelerators": {"type": "integer", "minimum": 1, "maximum": 4},
    "max_idletime": {"type": "number", "minimum": 30, "maximum": 3600},
    "init_blocks": {"type": "integer", "minimum": 0, "maximum": 2},
    "min_blocks": {"type": "integer", "minimum": 0, "maximum": 1},
    "max_blocks": {"type": "integer", "minimum": 0, "maximum": 2},
    "scheduler_options": {"type": "string"},
    "select_options": {"type": "string"},
    "worker_init": {"type": "string"},
    "requirements": {"type": "string", "maxLength": 65536}
  }
}
