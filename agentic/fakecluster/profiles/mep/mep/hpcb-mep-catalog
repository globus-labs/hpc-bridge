#!/usr/bin/env python3
"""Print this cluster's LOCAL CATALOG (hpc-bridge seed-format YAML): one MEP entry per manager, UUIDs read from the
endpoint.json each manager writes at its first start. Exit 1 (nothing printed) until BOTH have registered — the
readiness wait and run_smoke.sh retry on that. Runs inside login01 (installed by setup.d/login-mep.sh)."""
import datetime
import json
import os
import sys

VER = os.environ.get("HPCB_MEP_GCE_VERSION", "4.16.0")
ENV_SETUP = ("[ -d $HOME/hpc-bridge/gce-venv ] || uv venv -q --python 3.11 $HOME/hpc-bridge/gce-venv; "
             f". $HOME/hpc-bridge/gce-venv/bin/activate; uv pip install -q globus-compute-endpoint=={VER}")
KINDS = {
    "strict": "STRICT template schema (additionalProperties:false; no compute/interface/worker_init keys — Anvil's shape)",
    "open": "OPEN template schema (unknown keys pass through; compute:true required — globus1's shape)",
}
out = []
for kind, desc in KINDS.items():
    p = f"/root/.globus_compute/hpcb-mep-{kind}/endpoint.json"
    try:
        with open(p) as fh:
            eid = json.load(fh)["endpoint_id"]
    except Exception as exc:  # noqa: BLE001 - not registered yet
        print(f"hpcb-mep-catalog: {p}: {exc}", file=sys.stderr)
        sys.exit(1)
    out.append(f"""- id: fake-mep-{kind}
  facility_key: fake
  facility: "hpc-bridge fake cluster"
  description: "the fake site cluster via its facility multi-user endpoint — {desc} — zero SSH; compute-only (debug/compute/gpu, accounting enforced)"
  display_name: "fake cluster MEP ({kind})"
  aliases: [hpcb-mep-{kind}]
  compute_mep_uuid: {eid}
  ssh_host: null
  auth_method: ssh-key
  allocation: null
  account_required: true
  compute:
    scheduler: slurm
    interface: eth0
    env_setup: {json.dumps(ENV_SETUP)}
    scratch_root: "$HOME/.hpc-bridge"
    endpoint_name: hpcb-mep-{kind}
  defaults:
    partition: compute
    walltime: "00:30:00"
    max_workers_per_node: 2
    nodes_per_block: 1
    init_blocks: 1
    max_blocks: 1
  provenance: session
  last_validated: {datetime.date.today().isoformat()}
""")
print("# hpc-bridge fake cluster — LOCAL catalog generated by hpcb-mep-catalog (MEP UUIDs are minted per cluster)")
print("".join(out), end="")
